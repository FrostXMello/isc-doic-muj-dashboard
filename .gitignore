# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# local IDE
.idea/
.vscode/
*.swp
*.swo

# temp
tmp/
*.tmp

# local databases
*.sqlite
*.sqlite3
*.db

# debug and logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# env files (keep .env.example if one is added later)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local state
supabase/.temp
supabase/.branches

# internal-only data (nodal officer contacts); never commit — the repo is public
data/private/
supabase/private/

# typescript
*.tsbuildinfo
next-env.d.ts
