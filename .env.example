# Copy to .env.local and fill in. Never commit real values.
# No variables are required: without them the site runs on the static official dataset.

# Supabase project (Dashboard → Project Settings → API). Both are public values;
# access is enforced by row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key (only if your project has no sb_publishable_ key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Origin used in password-reset email links (e.g. https://isc-doic-muj-dashboard.vercel.app).
# Falls back to the request host. Must match a redirect URL allowed in Supabase Auth.
# NEXT_PUBLIC_SITE_URL=

# Internal Portal data source: static (default) | supabase.
# `supabase` reads as the signed-in user; without a session, internal records are hidden by RLS.
INTERNAL_DATA_SOURCE=static

# Mix fictional sample records ("Example …" institutions, invented agreements,
# calls, documents, activities) into the Internal Portal. Off unless exactly "true".
# Never enable on a deployment staff rely on; ignored on Vercel production.
INTERNAL_SAMPLE_DATA=false

# Never put the service-role / secret key or the database password in this app's env.
